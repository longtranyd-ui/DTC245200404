{
  "uid": "de28-overview",
  "title": "De 28 - Container, Nginx va PostgreSQL",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "Asia/Bangkok",
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Nguon giam sat UP (1 = hoat dong)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-de28"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "PostgreSQL san sang (1 = ket noi duoc)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-de28"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up",
          "legendFormat": "PostgreSQL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "CPU tung container de 28 (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-de28"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (label_replace(rate(container_cpu_usage_seconds_total{job=\"cadvisor\",container_label_com_docker_compose_project=\"dtc245200404-de28\",image!=\"\"}[2m]), \"service\", \"$1\", \"container_label_com_docker_compose_service\", \"(.+)\")) * 100",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "RAM tung container de 28",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-de28"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service) (label_replace(container_memory_working_set_bytes{job=\"cadvisor\",container_label_com_docker_compose_project=\"dtc245200404-de28\",image!=\"\"}, \"service\", \"$1\", \"container_label_com_docker_compose_service\", \"(.+)\"))",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Nginx yeu cau / giay",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-de28"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nginx_http_requests_total[2m])",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Nginx ket noi dang mo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-de28"
      },
      "gridPos": {
